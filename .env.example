# LLM provider: local (default, private) | anthropic (opt-in, sends data to Anthropic)
LLM_PROVIDER=local

# Local LLM (LM Studio, OpenAI-compatible)
LOCAL_LLM_BASE_URL=http://localhost:1234/v1
LOCAL_LLM_MODEL=qwen2.5-7b-instruct

# Cloud LLM (only used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Google OAuth client (downloaded from Google Cloud; keep gitignored)
GOOGLE_CREDENTIALS_PATH=./credentials.json

# Server — localhost only
APP_HOST=127.0.0.1
APP_PORT=8000

# Safety guardrail — MUST stay false for the MVP
ALLOW_SEND=false

LOG_LEVEL=INFO
